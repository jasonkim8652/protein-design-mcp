# Reuse the published integrated environments and public model assets.
# This patch changes server/engine code, not the bundled scientific dependencies.
ARG BASE_IMAGE=jasonkim8652/protein-design-mcp:2.4.2@sha256:d98c2aaee98907b10b16ea1325f68b8c07f15591ae5abfc7c9191c06fe105cb5
FROM ${BASE_IMAGE}
USER root
COPY pyproject.toml README.md LICENSE /app/
COPY src/ /app/src/
COPY scripts/ /app/scripts/
RUN micromamba run -n server pip install --no-cache-dir --no-deps /app \
    && chmod -R a+rX /app
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.version="2.4.3" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
USER $MAMBA_USER
