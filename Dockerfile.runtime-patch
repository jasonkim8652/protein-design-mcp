# Reuse the published integrated environments and public model assets.
# This patch changes server/engine code, not the bundled scientific dependencies.
ARG BASE_IMAGE=jasonkim8652/protein-design-mcp:2.4.3@sha256:0b0a40d409374e0d858292a7c09cd7aa386a9354b8bf3b9be4fda30d1ff3fad0
FROM ${BASE_IMAGE}
USER root
COPY pyproject.toml README.md LICENSE /app/
COPY src/ /app/src/
COPY scripts/ /app/scripts/
RUN micromamba run -n server pip install --no-cache-dir --no-deps /app \
    && chmod -R a+rX /app
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.version="2.4.4" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
USER $MAMBA_USER
